# Copia este archivo como .env y cambia los valores. El .env real nunca se sube al repositorio.

# Base de datos
DB_DATABASE=robotics
DB_USERNAME=robotics
DB_PASSWORD=cambia-esta-clave

# API: llave de Laravel. Generarla con:  php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
# Firma de los tokens, mínimo 32 caracteres. Generarla con:  php -r "echo base64_encode(random_bytes(48)), PHP_EOL;"
JWT_SECRET=
# Admin inicial que se crea al arrancar la API
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# Puertos en tu computador (opcionales). Cámbialos si 5432, 8000 o 5173 ya están ocupados.
# DB_PORT=5432
# API_PORT=8000
# APP_PORT=5173
